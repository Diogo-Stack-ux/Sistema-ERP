generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  empresaId Int
  nome      String
  email     String
  telefone  String
  endereco  String
  createdAt DateTime @default(now())

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  eventos       Evento[]
  ordensServico OrdemServico[]
  equipamentos  Equipamento[]
  lembretes     Lembrete[]

  @@index([empresaId])
}

model Produto {
  id         Int      @id @default(autoincrement())
  empresaId  Int
  nome       String
  sku        String?
  quantidade Int
  preco      Float
  tipo       String
  createdAt  DateTime @default(now())

  movimentacoes Movimentacao[]
  osProdutos    OSProduto[]
  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@unique([empresaId, sku])
}

model Movimentacao {
  id         Int      @id @default(autoincrement())
  empresaId  Int
  produtoId  Int
  tipo       String
  quantidade Int
  data       DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
}

model Gasto {
  id         Int       @id @default(autoincrement())
  empresaId  Int
  descricao  String
  valor      Float
  tipo       String    @default("DESPESA") // DESPESA | RECEITA
  categoria  String?
  status     String    @default("PENDENTE") // PENDENTE | PAGO | RECEBIDO | CANCELADO
  vencimento DateTime?
  data       DateTime  @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
}

model Evento {
  id        Int      @id @default(autoincrement())
  empresaId Int
  titulo    String
  descricao String?
  tipo      String
  data      DateTime
  concluido Boolean  @default(false)

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
}

model Lembrete {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  clienteId     Int
  equipamentoId Int?
  titulo        String
  mensagem      String?
  dataLembrete  DateTime
  status        String   @default("PENDENTE")
  canal         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  equipamento Equipamento? @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@index([clienteId])
  @@index([equipamentoId])
  @@index([dataLembrete])
  @@index([status])
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  createdAt DateTime @default(now())

  @@index([empresaId])
}

model Service {
  id        Int     @id @default(autoincrement())
  empresaId Int
  nome      String
  descricao String?
  categoria String?
  valor     Float
  garantia  Int? // dias
  duracao   Int? // minutos
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  osServicos OSServico[]
  empresa    Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
}

model OrdemServico {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  status      String   @default("ABERTA") // ABERTA | EM_ANDAMENTO | CONCLUIDA
  observacoes String?
  valorTotal  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  servicos      OSServico[]
  produtos      OSProduto[]
  equipamento   Equipamento? @relation(fields: [equipamentoId], references: [id])
  equipamentoId Int?
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
}

model OSServico {
  id             Int          @id @default(autoincrement())
  ordemServicoId Int
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  serviceId      Int
  service        Service      @relation(fields: [serviceId], references: [id])
  valor          Float
}

model OSProduto {
  id             Int          @id @default(autoincrement())
  ordemServicoId Int
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  produtoId      Int
  produto        Produto      @relation(fields: [produtoId], references: [id])
  quantidade     Int
  precoUnitario  Float
}

model Equipamento {
  id            Int       @id @default(autoincrement())
  empresaId     Int
  clienteId     Int
  nome          String
  tipo          String?
  marca         String?
  modelo        String?
  numeroSerie   String?
  identificacao String?
  dataCompra    DateTime?
  garantiaAte   DateTime?
  observacoes   String?
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  frequenciaRevisao     Int?
  tipoFrequenciaRevisao String?

  cliente       Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordensServico OrdemServico[]
  lembretes     Lembrete[]
  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([empresaId])
}

model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String
  cnpj      String?  @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios Usuario[]
  clientes Cliente[]
  produtos Produto[]
  movimentacoes Movimentacao[]
  gastos Gasto[]
  eventos Evento[]
  lembretes Lembrete[]
  services Service[]
  ordensServico OrdemServico[]
  equipamentos Equipamento[]
}
